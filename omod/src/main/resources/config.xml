<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.cag</package>
	<author>MoH-Lesotho</author>
	<description>
		${project.parent.description}
	</description>

	<activator>org.openmrs.module.cag.CagActivator</activator>

	<!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->

	<require_version>2.5.0</require_version>

	<!-- Extensions -->
	<extension>
		<point>org.openmrs.admin.list</point>
		<class>org.openmrs.module.cag.extension.html.AdminList</class>
	</extension>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
		<aware_of_module version="1.24.5">org.openmrs.module.emrapi</aware_of_module>
		<aware_of_module version="1.16.0">org.openmrs.module.reporting</aware_of_module>
		<aware_of_module version="0.2.12">org.openmrs.module.emrapi-api-1.12</aware_of_module>
		<aware_of_module version="2.5.0">org.openmrs.module.providermanagement</aware_of_module>
		<aware_of_module version="1.2">org.openmrs.calculation</aware_of_module>
	</aware_of_modules>

	<require_modules>
		<require_module version="${webservicesRestVersion}">org.openmrs.module.webservices.rest</require_module>
	</require_modules>

	<webservices>
		<rest>
			<version>1.0</version>
			<!--			<resource>org.openmrs.module.mymodule.api.rest.CagResource</resource>-->
			<resource>org.openmrs.module.cag.web.resource.CagResource</resource>
			<resource>org.openmrs.module.cag.web.resource.CagPatientResource</resource>
			<resource>org.openmrs.module.cag.web.resource.CagVisitResource</resource>
			<resource>org.openmrs.module.cag.web.resource.CagEncounterResource</resource>
		</rest>
	</webservices>



	<!-- AOP -->
	<!-- Maps the CAG attender's follow-up form onto the other present members' CAG visits
	     (replaces the browser-side POST cagEncounter of the Bahmni 0.92 Clinical app). -->
	<advice>
		<point>org.openmrs.api.EncounterService</point>
		<class>org.openmrs.module.cag.advice.CagEncounterSaveAdvice</class>
	</advice>
	<!-- /AOP -->

	<globalProperty>
		<property>cag.propagation.enabled</property>
		<defaultValue>true</defaultValue>
		<description>Map the CAG attender's follow-up form onto the other present members' CAG visits.</description>
	</globalProperty>
	<globalProperty>
		<property>cag.propagation.encounterTypeUuids</property>
		<defaultValue>81852aee-3f10-11e4-adec-0800271c1b75</defaultValue>
		<description>Comma-separated encounter type uuids whose saves are mapped (default: Consultation).</description>
	</globalProperty>
	<globalProperty>
		<property>cag.propagation.formConceptUuid</property>
		<defaultValue>746818ac-65a0-4d74-9609-ddb2c330a31b</defaultValue>
		<description>Top-level obs (form) that is mapped (default: HIV Treatment and Care Progress Template).</description>
	</globalProperty>
	<globalProperty>
		<property>cag.propagation.formNames</property>
		<defaultValue>HIV Treatment and Care Follow Up 2026</defaultValue>
		<description>Comma-separated Form Builder form names (any version) whose top-level obs are mapped like the template above.</description>
	</globalProperty>
	<globalProperty>
		<property>cag.propagation.copiedConceptUuids</property>
		<defaultValue>27d55083-5e66-4b5a-91d3-2c9a42cc9996,9eb00622-1078-4f7b-aa69-61e6c36db347,ed064424-0331-47f6-9532-77156f40a014,88489023-783b-4021-b7a9-05ca9877bf67</defaultValue>
		<description>Comma-separated questions whose answers are copied from the attender as-is (default: ARV drugs No. of days dispensed, HIVTC ARV drugs supply duration, Appointment scheduled, ART Follow-up date).</description>
	</globalProperty>
	<globalProperty>
		<property>cag.propagation.ownRegimenConceptUuid</property>
		<defaultValue>13382e01-9f18-488b-b2d2-58ab54c82d82</defaultValue>
		<description>Question answered with each member's own latest value instead of the attender's (default: HIVTC, ART Regimen).</description>
	</globalProperty>
	<globalProperty>
		<property>cag.propagation.clientTypeConceptUuid</property>
		<defaultValue>e0bc761d-ac3b-4033-92c7-476304b9c5e8</defaultValue>
		<description>Question set to the buddy answer on members' copies (default: Type of client).</description>
	</globalProperty>
	<globalProperty>
		<property>cag.propagation.clientTypeBuddyAnswerUuid</property>
		<defaultValue>0f880c52-3ced-43ac-a79b-07a2740ae428</defaultValue>
		<description>Answer used for members' client type (default: Treatment Buddy).</description>
	</globalProperty>
	<globalProperty>
		<property>cag.propagation.followUpDateConceptUuid</property>
		<defaultValue>88489023-783b-4021-b7a9-05ca9877bf67</defaultValue>
		<description>Question whose date is stored as cag_encounter.next_encounter_date (default: ART, Follow-up date).</description>
	</globalProperty>


	<!-- Required Privileges
	<privilege>
		<name>Form Entry</name>
		<description>Allows user to access Form Entry pages/functions</description>
	</privilege>
	 /Required Privileges -->


